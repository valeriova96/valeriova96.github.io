---
import Base from '../layouts/Base.astro';
import { Picture } from 'astro:assets';
import hero from '../assets/images/me2.jpg';
import sourdough from '../assets/images/sourdough.jpg';

const experience = [
  {
    period: '2026 · now',
    role: 'Data Scientist',
    company: 'Aixelerate',
    companyHref: 'https://www.aixelerateresearch.com/',
    summary:
      'Owning the AI layer of a research platform: agent-driven analysis tools, explainable statistical components, and the product surfaces around them. The job is moving the multi-agent architecture out of dev and into production-grade. In practice, that means deleting the parts that only worked on a good day. The UX gets the same scrutiny as the model.',
  },
  {
    period: '2024 · 2026',
    role: 'Data Scientist',
    company: 'InSilicoTrials Technologies',
    companyHref: 'https://insilicotrials.com/',
    summary:
      "Designed the company's multi-agent chatbot, including a Model Context Protocol server that gave the LLM real tools instead of hallucinations dressed as ones. Shipped a tabular synthetic-data workflow on a SOTA foundation model, plus the reproducible Azure ML pipelines that kept the research teams from sharing notebooks named `final_v3_real.ipynb`. Placed top 5 in an FDA challenge with a regulatory-compliant RAG and its own evaluation harness.",
  },
  {
    period: '2023 · 2024',
    role: 'Junior Data Scientist',
    company: 'Miraitek',
    companyHref: 'https://www.miraitek.com/',
    summary:
      'Built a RAG retrieval agent on AWS that cut document-processing time for manufacturing clients, and surfaced enough operational waste through pattern recognition to lift production performance by 7%. Apache Superset + SQL dashboards turned the rest of the guesswork into numbers people could argue about.',
  },
];

const projects = [
  {
    period: '2025',
    title: 'mcpadapt, upstream contribution',
    summary:
      `Upstream contribution to <a href="https://github.com/grll/mcpadapt" target="_blank" rel="noopener noreferrer">mcpadapt</a>, an open-source bridge between agent frameworks and <a href="https://www.anthropic.com/news/model-context-protocol" target="_blank" rel="noopener noreferrer">Model Context Protocol</a> servers. The kind of work that doesn't make a slide deck but quietly fixes friction for everyone downstream of it.`,
  },
  {
    period: '2024',
    title: 'FDA challenge, top-5 finish',
    summary:
      `Top-5 finish in a <a href="https://precision.fda.gov/challenges/34/results" target="_blank" rel="noopener noreferrer">precisionFDA challenge</a> with a regulatory-compliant RAG and its own evaluation harness. Built so the answers were traceable enough for regulators to read, not just for users to nod at.`,
  },
];

const certs = [
  {
    year: 'Aug 2024',
    title: 'Deploying Machine Learning Models in Production',
    issuer: 'DeepLearning.AI',
    href: 'https://www.coursera.org/account/accomplishments/verify/OC06EOAHREQU',
    credentialLabel: 'OC06EOAHREQU',
  },
  {
    year: 'Aug 2024',
    title: 'Introduction to Retrieval Augmented Generation',
    issuer: 'Duke University',
    href: 'https://www.coursera.org/account/accomplishments/verify/UT2G2PAI109Z',
    credentialLabel: 'UT2G2PAI109',
  },
  {
    year: 'May 2024',
    title: 'Machine Learning in Production',
    issuer: 'DeepLearning.AI',
    href: 'https://www.coursera.org/account/accomplishments/verify/96CN9B7M28XA',
    credentialLabel: '96CN9B7M28XA',
  },
  {
    year: 'Nov 2021',
    title: 'Huawei Seeds For The Future, top 3.6%',
    issuer: 'Huawei',
    href: 'https://magazine.unibo.it/archivio/2021/12/17/team-con-studenti-unibo-vincitore-al-seeds-for-the-future',
    credentialLabel: 'Read the article',
  },
];

const sideQuests = [
  {
    label: 'Reading',
    body: 'Usually mid-book on something I can\'t put down. The current rotation lives on the',
    linkHref: '/recommended-reads/',
    linkLabel: 'reading shelf',
    bodyTail: '.',
  },
  {
    label: 'Manga',
    body: 'Occasional deep dives I will regret the next morning, and recommend the morning after that.',
  },
  {
    label: 'Outdoors',
    body: 'Pretending I have a balanced life. Hiking, long walks, anywhere with a view.',
  },
];
---
<Base
  title="Valerio Valente, Data Scientist and AI Engineer"
  description="Personal site of Valerio Valente, a data scientist and AI engineer based in Italy. I build AI systems that survive contact with reality: MLOps, LLM apps, and production ML pipelines."
  ogType="profile"
  person={true}
>
  <article class="page">
    {/* ---------- Hero ---------- */}
    <section id="top" class="hero">
      <div class="hero__photo">
        <Picture
          src={hero}
          alt="Valerio Valente, portrait"
          widths={[320, 640]}
          sizes="(max-width: 720px) 220px, 320px"
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          loading="eager"
          fetchpriority="high"
          pictureAttributes={{ class: 'hero__picture' }}
          class="hero__img"
        />
      </div>

      <div class="hero__prose">
        <h1 class="display">
          Valerio Valente<span class="display-stop">.</span>
        </h1>
        <p class="hero__lede">
          I build AI systems that survive contact with reality.
        </p>
        <div class="prose">
          <p>
            If your idea of fun is digging into the messy details instead of waving hands at a slide
            deck, we are already friends. The work I keep coming back to has one thing in common: the
            answer matters enough that no one gets to fake it. Regulators have to read it, researchers
            have to trust it, or factory floors have to act on it. That tends to leave behind the
            AI-on-stage version and keep the AI-on-disk version, which is the one I find interesting.
          </p>
          <p>
            When I am not doing that, I am outside pretending I have a balanced life, reading
            something I cannot put down, or deep into a manga binge I will regret the next morning.
            I also bake sourdough: controlled fermentation dressed up as a hobby. Same job, really.
          </p>
        </div>
        <div class="hero__actions">
          <a href="#contact" class="btn-primary">Get in touch</a>
          <a
            href="/files/valerio_valente_resume.pdf"
            download="valerio_valente_resume.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-ghost"
          >
            Download resume
          </a>
        </div>
      </div>
    </section>

    {/* ---------- Experience ---------- */}
    <section id="experience" class="section">
      <header class="section__head">
        <p class="section-eyebrow">Experience</p>
        <h2 class="section-title">Where I have worked, in reverse order.</h2>
      </header>

      <ol class="entries" role="list">
        {experience.map((entry) => (
          <li class="entry">
            <p class="marginalia marginalia--year entry__year">{entry.period}</p>
            <div class="entry__body">
              <h3 class="entry__title">
                {entry.role}
                <span class="entry__company">
                  <span aria-hidden="true">&nbsp;&middot;&nbsp;</span>
                  {entry.companyHref ? (
                    <a href={entry.companyHref} target="_blank" rel="noopener noreferrer">{entry.company}</a>
                  ) : (
                    entry.company
                  )}
                </span>
              </h3>
              <p class="entry__summary">{entry.summary}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    {/* ---------- Selected Projects ---------- */}
    <section id="work" class="section">
      <header class="section__head">
        <p class="section-eyebrow">Selected Projects</p>
        <h2 class="section-title">A few things I am proudest of.</h2>
      </header>

      <ol class="entries" role="list">
        {projects.map((p) => (
          <li class="entry">
            <p class="marginalia marginalia--year entry__year">{p.period}</p>
            <div class="entry__body">
              <h3 class="entry__title">{p.title}</h3>
              <p class="entry__summary" set:html={p.summary}></p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    {/* ---------- Side Quests ---------- */}
    <section id="side-quests" class="section">
      <header class="section__head">
        <p class="section-eyebrow">Side Quests</p>
        <h2 class="section-title">The hobbies are load-bearing.</h2>
      </header>

      <div class="quest-featured">
        <figure class="quest-featured__photo">
          <Picture
            src={sourdough}
            alt="A halved sourdough loaf, crust stacked on crumb, resting on a floured wooden board against a tiled wall."
            widths={[420, 720, 1080]}
            sizes="(max-width: 820px) 100vw, 38vw"
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            loading="lazy"
            pictureAttributes={{ class: 'quest-featured__picture' }}
            class="quest-featured__img"
          />
          <figcaption class="marginalia quest-featured__caption">
            This loaf cooperated. Most do not.
          </figcaption>
        </figure>

        <div class="quest-featured__body">
          <p class="marginalia quest-featured__label">Sourdough</p>
          <p class="quest-featured__lede">
            Controlled fermentation dressed up as a hobby. Three ingredients,
            unforgiving failure modes, a feedback loop patient enough to be honest.
          </p>
        </div>
      </div>

      <dl class="quests">
        {sideQuests.map((q) => (
          <div class="quest">
            <dt class="quest__label marginalia">{q.label}</dt>
            <dd class="quest__body">
              {q.body}
              {q.linkHref && (
                <>
                  {' '}<a href={q.linkHref}>{q.linkLabel}</a>{q.bodyTail}
                </>
              )}
            </dd>
          </div>
        ))}
      </dl>
    </section>

    {/* ---------- Certifications & Awards ---------- */}
    <section id="certifications" class="section">
      <header class="section__head">
        <p class="section-eyebrow">Certifications &amp; Awards</p>
        <h2 class="section-title">Receipts.</h2>
      </header>

      <ol class="entries" role="list">
        {certs.map((c) => (
          <li class="entry">
            <p class="marginalia marginalia--year entry__year">{c.year}</p>
            <div class="entry__body">
              <h3 class="entry__title">
                {c.title}
                <span class="entry__company">
                  <span aria-hidden="true">&nbsp;&middot;&nbsp;</span>
                  {c.issuer}
                </span>
              </h3>
              <p class="entry__summary marginalia">
                <a href={c.href} target="_blank" rel="noopener noreferrer">{c.credentialLabel}</a>
              </p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    {/* ---------- Contact ---------- */}
    <section id="contact" class="section section--contact">
      <header class="section__head">
        <p class="section-eyebrow">Hello</p>
        <h2 class="section-title">Say hi, share a draft, suggest a book.</h2>
        <p class="prose section__intro">
          The fastest reply paths are the social ones below. The form is fine too if a longer note
          is easier. Either way, I read everything.
        </p>
      </header>

      <ul class="socials" role="list">
        <li>
          <a href="https://github.com/valeriova96" target="_blank" rel="noopener noreferrer" aria-label="GitHub profile">
            <span class="socials__label">GitHub</span>
            <span class="marginalia">/valeriova96</span>
          </a>
        </li>
        <li>
          <a href="https://www.linkedin.com/in/valerio-valente/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile">
            <span class="socials__label">LinkedIn</span>
            <span class="marginalia">/valerio-valente</span>
          </a>
        </li>
        <li>
          <a href="https://medium.com/@valeriovalente96" target="_blank" rel="noopener noreferrer" aria-label="Medium profile">
            <span class="socials__label">Medium</span>
            <span class="marginalia">@valeriovalente96</span>
          </a>
        </li>
      </ul>

      <form action="https://formspree.io/f/movlqqpz" method="POST" class="contact-form" aria-labelledby="contact-heading">
        <h3 id="contact-heading" class="visually-hidden">Contact form</h3>
        <div class="contact-form__row">
          <label class="field-label" for="name">Name</label>
          <input class="field-input" type="text" name="name" id="name" required autocomplete="name" />
        </div>
        <div class="contact-form__row">
          <label class="field-label" for="email">Email</label>
          <input class="field-input" type="email" name="email" id="email" required autocomplete="email" />
        </div>
        <div class="contact-form__row">
          <label class="field-label" for="message">Message</label>
          <textarea class="field-textarea" name="message" id="message" rows="5" required></textarea>
        </div>
        <div class="contact-form__row contact-form__consent">
          <label>
            <input type="checkbox" name="privacy" required />
            <span class="marginalia">
              I agree to the <a href="/privacy/" target="_blank" rel="noopener noreferrer">privacy policy</a>.
            </span>
          </label>
        </div>
        <button type="submit" class="btn-primary">Send message</button>
      </form>
    </section>
  </article>
</Base>

<style>
  .page {
    max-width: 64rem;
    margin: 0 auto;
    padding: clamp(2rem, 4vw, 4rem) clamp(1.25rem, 3vw, 2.5rem) 0;
  }

  /* ---------- Hero ---------- */

  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
    padding-block: clamp(2.5rem, 5vw, 5rem);
  }

  @media (min-width: 820px) {
    .hero {
      grid-template-columns: 5fr 7fr;
      gap: clamp(3rem, 5vw, 5rem);
    }
  }

  .hero__photo {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .hero__picture {
    display: block;
  }

  .hero__img {
    display: block;
    width: clamp(180px, 36vw, 320px);
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border: 1px solid var(--color-rule);
    border-radius: 2px;
  }

  .hero__caption {
    max-width: 26ch;
  }

  .hero__prose {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .hero__lede {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(1.25rem, 0.5vw + 1.1rem, 1.55rem);
    line-height: 1.3;
    color: var(--color-ink);
    max-width: 36ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  /* ---------- Section scaffolding ---------- */

  .section {
    padding-block: clamp(3rem, 6vw, 5.5rem);
    border-top: 1px solid var(--color-rule);
  }

  .section__head {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    max-width: 52ch;
    margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
  }

  .section__intro {
    margin-top: 0.25rem;
  }

  /* ---------- Entries (rows with hairline rules) ---------- */

  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .entry {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.4rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--color-rule);
  }

  .entries .entry:first-child {
    border-top: 1px solid var(--color-rule);
  }

  @media (min-width: 720px) {
    .entry {
      grid-template-columns: 8.5rem 1fr;
      gap: 1.5rem;
      padding-block: 1.75rem;
    }
  }

  .entry__year {
    padding-top: 0.4rem;
    color: var(--color-ink-soft);
  }

  .entry__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }

  .entry__title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(1.15rem, 0.4vw + 1.05rem, 1.3rem);
    line-height: 1.3;
    letter-spacing: -0.005em;
    color: var(--color-ink);
  }

  .entry__company {
    font-weight: 400;
    color: var(--color-ink-soft);
  }

  .entry__company a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in oklch, var(--color-rule) 70%, transparent);
    transition: color 180ms cubic-bezier(0.22, 1, 0.36, 1),
                border-color 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .entry__company a:hover {
    color: var(--color-terracotta);
    border-bottom-color: var(--color-terracotta);
  }

  .entry__summary {
    color: var(--color-ink);
    font-size: 1.025rem;
    line-height: 1.6;
    max-width: 68ch;
  }

  /* :global(a) so the rule also reaches anchors injected via set:html
     (Selected Projects summaries), which don't carry Astro's scoping attribute. */
  .entry__summary :global(a) {
    color: var(--color-terracotta);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    text-decoration-color: color-mix(in oklch, var(--color-terracotta) 55%, transparent);
    transition: color 200ms cubic-bezier(0.22, 1, 0.36, 1),
                text-decoration-color 200ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .entry__summary :global(a:hover) {
    color: var(--color-terracotta-deep);
    text-decoration-color: var(--color-terracotta-deep);
  }

  .entry:hover .entry__year {
    color: var(--color-terracotta);
  }

  /* ---------- Side Quests ---------- */

  .quest-featured {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: start;
    margin-bottom: clamp(2.25rem, 4vw, 3.25rem);
  }

  @media (min-width: 820px) {
    .quest-featured {
      grid-template-columns: 5fr 7fr;
      gap: clamp(2.5rem, 4vw, 4rem);
    }
  }

  .quest-featured__photo {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: flex-start;
    margin: 0;
  }

  .quest-featured__picture {
    display: block;
  }

  .quest-featured__img {
    display: block;
    width: 100%;
    max-width: 380px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border: 1px solid var(--color-rule);
    border-radius: 2px;
  }

  .quest-featured__caption {
    color: var(--color-ink-soft);
    max-width: 30ch;
  }

  .quest-featured__body {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding-top: 0.25rem;
  }

  .quest-featured__label {
    color: var(--color-ink-soft);
  }

  .quest-featured__lede {
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 0.4vw + 1.05rem, 1.3rem);
    line-height: 1.55;
    color: var(--color-ink);
    max-width: 48ch;
  }

  .quests {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 720px) {
    .quests {
      grid-template-columns: 1fr 1fr;
      gap: 1.75rem 3rem;
    }
  }

  .quest {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 1rem;
    padding-block: 1rem;
    border-top: 1px solid var(--color-rule);
  }

  .quest__label {
    padding-top: 0.15rem;
  }

  .quest__body {
    font-size: 1.025rem;
    line-height: 1.6;
    color: var(--color-ink);
    max-width: 48ch;
  }

  .quest__body a {
    color: var(--color-terracotta);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    text-decoration-color: color-mix(in oklch, var(--color-terracotta) 55%, transparent);
  }

  .quest__body a:hover {
    color: var(--color-terracotta-deep);
    text-decoration-color: var(--color-terracotta-deep);
  }

  /* ---------- Contact ---------- */

  .section--contact {
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .socials {
    list-style: none;
    margin: 0 0 2.5rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2.5rem;
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
    padding-block: 1.25rem;
  }

  .socials a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    color: var(--color-ink);
    transition: color 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .socials a:hover {
    color: var(--color-terracotta);
  }

  .socials__label {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.05rem;
  }

  /* ---------- Contact form ---------- */

  .contact-form {
    max-width: 36rem;
    display: grid;
    gap: 1.5rem;
  }

  .contact-form__row {
    display: flex;
    flex-direction: column;
  }

  .contact-form__consent label {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.6rem;
    color: var(--color-ink);
  }

  .contact-form__consent input[type='checkbox'] {
    margin-top: 0.25rem;
    accent-color: var(--color-terracotta);
  }

  .contact-form__consent a {
    color: var(--color-terracotta);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .contact-form button[type='submit'] {
    justify-self: start;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
