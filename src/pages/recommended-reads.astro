---
import Base from '../layouts/Base.astro';
import books from '../../public/files/books.json';

function resolveAssetPath(value) {
  if (!value) return '';
  if (/^(https?:|data:|\/)/i.test(value)) return value;
  return '/' + value;
}

function getBookLink(book) {
  if (book.amazonUrl) {
    return { url: book.amazonUrl, iconClass: 'fab fa-amazon', label: 'View on Amazon' };
  }
  if (book.externalUrl) {
    return {
      url: book.externalUrl,
      iconClass: 'fas fa-link',
      label: book.externalLabel || 'View resource',
    };
  }
  return null;
}
---
<Base
  title="Recommended Reads — Valerio Valente"
  description="Books that shaped my work in machine learning, AI engineering, and shipping ML systems to production. Curated notes and reviews."
  activeLink="books"
>
  <div class="container mx-auto px-6 py-12 max-w-6xl">
    <h1 class="text-3xl md:text-4xl font-bold text-center mb-4">Recommended Reads</h1>
    <p class="text-gray-400 text-center mb-12 max-w-2xl mx-auto">
      Books that have shaped my understanding of ML, AI Engineering, and building production-grade systems. This collection is in no particular order.
    </p>

    <div class="space-y-6">
      {books.map((book, i) => {
        const id = `book-${i + 1}`;
        const link = getBookLink(book);
        const imageAlt = book.imageAlt || book.title;
        return (
          <article class="book-row rounded-lg p-4 sm:p-6" id={`${id}-container`}>
            <div class="flex flex-col sm:flex-row gap-4 sm:gap-6 sm:items-start">
              <div class="w-24 h-32 flex-shrink-0 overflow-hidden rounded-lg shadow-lg bg-dark-700 flex items-center justify-center">
                <img
                  src={resolveAssetPath(book.image)}
                  alt={imageAlt}
                  width="96"
                  height="128"
                  loading="lazy"
                  class="w-full h-full object-cover"
                />
              </div>
              <div class="flex-grow min-w-0">
                <div class="flex items-start justify-between gap-4 mb-2">
                  <div>
                    <h3 class="text-xl font-semibold text-white mb-1">{book.title}</h3>
                    <p class="text-gray-400 text-sm">{book.author} • {book.publisher} • {book.year}</p>
                  </div>
                </div>
                <div class="text-gray-300 text-sm mt-3 rich-review">
                  <div set:html={book.preview} />
                  {book.fullReview && (
                    <div id={`${id}-full`} class="hidden mt-2" set:html={book.fullReview} />
                  )}
                </div>
                {book.fullReview && (
                  <button
                    id={`${id}-btn`}
                    data-target={`${id}-full`}
                    class="text-primary-500 hover:text-primary-400 ml-1 underline focus:outline-none text-sm"
                  >Read more</button>
                )}
                {link && (
                  <div class="mt-3">
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 text-primary-500 hover:text-primary-400 transition-colors text-sm font-medium"
                    >
                      <i class={link.iconClass}></i>
                      {link.label}
                    </a>
                  </div>
                )}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>

  <script>
    document.querySelectorAll('button[data-target]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        if (!targetId) return;
        const target = document.getElementById(targetId);
        if (!target) return;
        const isNowHidden = target.classList.toggle('hidden');
        btn.textContent = isNowHidden ? 'Read more' : 'Read less';
      });
    });
  </script>
</Base>
